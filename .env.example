# ==============================================================================
# ArchiMind AI - Environment Configuration Example
# ==============================================================================

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Vector Store Engine ("pgvector" or "memory")
# Use "memory" for standalone/offline runs without Docker, "pgvector" for production PostgreSQL
VECTOR_STORE_TYPE=memory

# PostgreSQL with pgvector Settings (Used when VECTOR_STORE_TYPE=pgvector)
POSTGRES_USER=archimind
POSTGRES_PASSWORD=archimind_secret
POSTGRES_DB=archimind_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+psycopg://archimind:archimind_secret@localhost:5432/archimind_db

# Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# LLM Provider Configuration ("mock", "openai", "anthropic", "gemini")
LLM_PROVIDER=mock

# OpenAI Settings (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Settings (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini Settings (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Retrieval & Guardrail Parameters
DEFAULT_TOP_K=4
SIMILARITY_THRESHOLD=0.35
MAX_CONTEXT_LENGTH=4000

# Security & Ingestion Whitelist (Comma-separated hostnames)
ALLOWED_DOC_DOMAINS=kafka.apache.org,redis.io,docs.aws.amazon.com,www.postgresql.org,www.envoyproxy.io,raft.github.io,raw.githubusercontent.com

# LangSmith Observability & Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=archimind-ai
